{
  "manifest_version": 3,
  "name": "PremiumShot for Chrome",
  "version": "0.2.0",
  "description": "Capture a visible tab or select a webpage component, choose a look, and copy a polished image. Processed locally.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Capture with PremiumShot" },
  "icons": { "16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
